# This file defines example environment variables for elevata.
# It is not code, but part of the build and configuration setup.
# ======================================================

# ======================================================
# Example .env file
# ------------------------------------------------------
# Copy this file to ".env" and adjust the values locally.
# This file defines environment variables used by:
#   - Django (core/)
#   - Docker Compose
#   - Makefile / PowerShell scripts
# ======================================================

# --- Current environment ---
ELEVATA_PROFILES_PATH=./config/elevata_profiles.yaml # project default, system-wide fallback eg: "/etc/elevata/elevata_profiles.yaml"
ELEVATA_PROFILE=dev

# elevata runtime role. Normal UI/modeling runtime: authoring.
# Headless TEST/PROD metadata deployment runtime: promotion_target.
ELEVATA_RUNTIME_MODE=authoring

# Metadata environment owned by this runtime.
# Distinct from ELEVATA_PROFILE even when both use labels such as dev/test/prod.
ELEVATA_ENVIRONMENT=dev

ELEVATA_AIRFLOW_DAGS_DIR=./examples/airflow/dags
ELEVATA_REPO_DIR=.

# -------------------------------------------------------
# elevata – Environment Promotion
# -------------------------------------------------------
# Directory used for immutable Architecture Release Bundles.
ELEVATA_PROMOTION_RELEASE_DIR=.elevata/promotion/releases

# Directory used for immutable Environment Promotion Approval Artifacts.
ELEVATA_PROMOTION_APPROVAL_DIR=.elevata/promotion/approvals

# Directory used for immutable approved Deployment Packages.
ELEVATA_PROMOTION_PACKAGE_DIR=.elevata/promotion/packages

# Directory used for successful Environment Promotion Records.
# On promotion targets this is target-authoritative audit evidence.
ELEVATA_PROMOTION_HISTORY_DIR=.elevata/promotion/history

# Maximum accepted deployment-package request body on a promotion target (64 MiB).
ELEVATA_PROMOTION_RUNNER_MAX_PACKAGE_BYTES=67108864

# Required only when ELEVATA_RUNTIME_MODE=promotion_target.
# Use a different random secret for every TEST/PROD target; minimum 32 characters.
# ELEVATA_PROMOTION_RUNNER_TOKEN=replace-with-at-least-32-random-characters

# Authoring-side Promotion Target registry.
# No remote target is contacted merely by opening the Environment Promotion page.
ELEVATA_PROMOTION_TARGETS=
# ELEVATA_PROMOTION_TARGET_TEST_URL=http://127.0.0.1:8001/metadata
# ELEVATA_PROMOTION_TARGET_TEST_TOKEN=replace-with-the-test-runner-token
ELEVATA_PROMOTION_TARGET_TIMEOUT_SECONDS=30

# Additional environments use the same dynamic naming contract, for example:
# ELEVATA_PROMOTION_TARGET_PROD_URL=https://elevata-prod.example.com/metadata
# ELEVATA_PROMOTION_TARGET_PROD_TOKEN=replace-with-the-prod-runner-token

# -------------------------------------------------------
# elevata – Architecture State
# -------------------------------------------------------
# Directory used for the persisted architecture state baseline.
ELEVATA_ARCH_STATE_DIR=.elevata/state

# Default behavior: architecture_state.json is persisted only after a successful --execute run.
# Set to true only if you intentionally want dry-runs to advance the baseline (rare).
ELEVATA_PERSIST_ARCH_STATE_ON_DRY_RUN=false

# Directory used for stored architecture approval artifacts.
# Used by elevata_approve --store and the Architecture Review Status UI.
ELEVATA_ARCH_APPROVAL_DIR=.elevata/approvals

# Directory used for stored Architecture Execution Records.
# Used by Architecture Control for controlled execution audit artifacts.
ELEVATA_ARCH_EXECUTION_DIR=.elevata/executions

# Architecture validation guard (optional)
# off: no additional output
# compare: print migration plan preview + shadow compare
# enforce: like compare, but blocks --execute when mismatches are detected
ELEVATA_ARCH_MODE=off

ELEVATA_ALLOW_AUTO_DROP_COLUMNS=false
ELEVATA_ALLOW_AUTO_DROP_HIST_COLUMNS=false
# Allow unsafe type evolution (narrowing/incompatible drift) via deterministic rebuild. Use with caution.
ELEVATA_ALLOW_TYPE_ALTER=false

# Allow elevata to drop orphaned physical dependent views in managed view schemas
# before full-refresh table rebuilds.
# Keep disabled by default. Enable only for explicit cleanup runs.
ELEVATA_ALLOW_ORPHAN_MANAGED_SCHEMA_DEPENDENT_VIEW_DROP=false

ELEVATA_SQL_DIALECT=duckdb
ELEVATA_TARGET_SYSTEM=dwh

# --- Pepper value for hash keys ---
# --- Option 1 (recommended): Profile-specific, aligns with elevata_profiles.yaml
SEC_DEV_PEPPER=supersecretpeppervalue

# --- Option 2 (fallback): Direct override
# ELEVATA_PEPPER=supersecretpeppervalue

# --- Source and target systems. Template: sec/{profile}/conn/{type}/{short_name} ---
SEC_DEV_CONN_MSSQL_ERP=mssql+pyodbc://user:password@server/dbname?driver=ODBC%20Driver%2018%20for%20SQL%20Server

SEC_DEV_CONN_BIGQUERY_DWH=bqdwh
GOOGLE_CLOUD_PROJECT="projectid"
GOOGLE_BIGQUERY_LOCATION=EU # or US

# --- Metadata connection details (used by Django, Docker) ---
DB_ENGINE=sqlite # or "postgres"

# Metadata database.
# SQLite: file name or path; relative paths are resolved against core/.
# Postgres: database name.
# e.g.: DB_NAME=elevata
DB_NAME=db.sqlite3

# --- Only fill out if using Postgres ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=elevata
DB_PASSWORD=elevata

# --- Django settings ---
DEBUG=True
SECRET_KEY='django-insecure-9djmsb%o6t9_nx780w#d+#d-51p9p**(5qu@9*=^c9w@ot*asq'
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Django database connection behavior ---
DB_CONN_MAX_AGE=60
DB_SSL_REQUIRE=false

# -------------------------------------------------------
# elevata – Auto-provisioning (schemas & meta logging)
# -------------------------------------------------------

# Automatically create target schemas (raw, stage, rawcore, …) if missing
ELEVATA_AUTO_PROVISION_SCHEMAS=true

# Automatically create tables if missing
ELEVATA_AUTO_PROVISION_TABLES=true

# Automatically create the meta.load_run_log table if missing
ELEVATA_AUTO_PROVISION_META_LOG=true

# Schema name used for load_run_log
ELEVATA_META_SCHEMA_NAME=meta

# --- Notes ---
# - Do NOT commit your real ".env" to version control.
# - For PostgreSQL, ensure Docker is running and the DB matches the above credentials.
# - Django automatically loads this file via python-dotenv.
